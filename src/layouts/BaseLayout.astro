---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.scss';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" style="scroll-behavior: smooth;">
	<head>
		<meta charset="utf-8" />
		<!--
			Runs before first paint so `html.js [data-reveal] { visibility: hidden }`
			(global.scss) applies from the very first frame, instead of reveal
			elements rendering fully visible and then snapping invisible when GSAP
			initialises at `astro:page-load`. Visitors without JS never get the class
			and so always see full content — progressive enhancement, not a
			permanently hidden trap.
		-->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<link rel="icon" href="/favicon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
		<script>
			import { consoleLogo, consoleLogoStyle } from '../lib/console-logo';
			console.log(consoleLogo, consoleLogoStyle);
		</script>
		<script>
			// `ClientRouter`'s swap wipes every attribute off <html> (see
			// `swapRootAttributes` in astro/dist/transitions/swap-functions.js) and
			// the inline <head> script above is not re-executed on navigation, so the
			// `js` class has to be re-applied. `astro:after-swap` runs synchronously
			// after the swap and before the new page paints, so the CSS guard never
			// lapses across client-side navigations.
			document.addEventListener('astro:after-swap', () => {
				document.documentElement.classList.add('js');
			});

			// GSAP + ScrollTrigger is ~44KB gzipped. Load it only on pages that
			// actually have something to reveal, and hold onto the teardown function
			// so `astro:before-swap` can run synchronously — an `await import()` there
			// would resolve in a microtask that can land after the incoming page's
			// `astro:page-load`, tearing down the new page's triggers instead.
			let teardownReveal: (() => void) | null = null;

			document.addEventListener('astro:page-load', async () => {
				if (!document.querySelector('[data-reveal]')) return;

				try {
					const { initRevealElements, teardownRevealElements } =
						await import('../lib/motion/reveal');
					teardownReveal = teardownRevealElements;
					initRevealElements();
				} catch {
					// Never leave content trapped behind the CSS visibility guard if the
					// motion chunk fails to load.
					document.documentElement.classList.remove('js');
				}
			});

			document.addEventListener('astro:before-swap', () => {
				teardownReveal?.();
			});
		</script>
	</body>
</html>
