---
import { icons } from './icons';
import { iconLabels } from './icon-labels';

interface Props {
	title: string;
	description: string;
	image?: string;
	stack: string[];
	links: { href: string; label: string; iconKey: string }[];
	detailsUrl?: string;
}

const { title, description, image, stack, links, detailsUrl } = Astro.props;
const ImagePlaceholderIcon = icons['mdi/image-outline'];
---

<article class="work-card">
	<div class="work-image">
		{
			image ? (
				<img src={image} alt={`${title} preview`} loading="lazy" />
			) : (
				<div class="image-placeholder">
					<ImagePlaceholderIcon />
				</div>
			)
		}
	</div>
	<div class="work-content">
		<h2>
			{detailsUrl ? <a class="work-title-link" href={detailsUrl}>{title}</a> : title}
		</h2>
		<p>{description}</p>
		{
			stack.length > 0 && (
				<div class="work-stack">
					{stack.map((key) => {
						const Icon = icons[key];
						const label = iconLabels[key] ?? key;
						return (
							<span class="stack-tag" role="img" aria-label={label} data-label={label}>
								<Icon />
							</span>
						);
					})}
				</div>
			)
		}
		<div class="work-links">
			{
				links.map((link) => {
					const Icon = icons[link.iconKey];
					return (
						<a href={link.href} target="_blank" rel="noopener noreferrer">
							<Icon />
							<span>{link.label}</span>
						</a>
					);
				})
			}
		</div>
	</div>
</article>

<style lang="scss">
	@use '../../styles/tokens' as *;

	.work-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid $glass-border;
		border-radius: $radius-md;
		background: $color-surface;
		overflow: hidden;
		transition:
			border-color $duration-hover $ease-out-quick,
			transform $duration-hover $ease-out-quick,
			box-shadow $duration-hover $ease-out-quick;

		&:hover,
		&:focus-within {
			border-color: rgba($color-accent, 0.4);
			transform: translateY(-4px);
			box-shadow: 0 12px 28px -16px rgba(0, 0, 0, 0.5);

			.work-image img {
				transform: scale(1.04);
			}
		}

		.work-image {
			aspect-ratio: 16 / 9;
			overflow: hidden;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.3s $ease-out-quick;
			}

			.image-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: $glass-fill;
				color: $color-text-muted;
				font-size: 2.5rem;
			}
		}

		.work-content {
			display: flex;
			flex-direction: column;
			flex: 1;
			padding: $space-5;
			gap: $space-3;

			h2 {
				font-family: $font-sans;
				font-weight: $font-weight-heading;
				font-size: 1.375rem;
				color: $color-text;
				margin: 0;
			}

			.work-title-link {
				color: inherit;
				text-decoration: none;

				// Stretched-link pattern: the whole card becomes this anchor's
				// hit area without wrapping the entire card markup (including
				// the nested GitHub/Demo links) in an <a>, which would be
				// invalid HTML (no nested interactive content).
				&::after {
					content: '';
					position: absolute;
					inset: 0;
				}

				&:hover,
				&:focus-visible {
					color: $color-accent;
				}
			}

			p {
				font-family: $font-sans;
				font-size: $font-size-body;
				color: $color-text-muted;
				line-height: 1.6;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 4;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.work-stack {
				display: flex;
				flex-wrap: wrap;
				gap: $space-1;

				.stack-tag {
					position: relative;
					display: flex;
					align-items: center;
					justify-content: center;
					padding: $space-1;
					border: 1px solid rgba($color-accent, 0.2);
					border-radius: $radius-sm;
					background: rgba($color-accent, 0.08);
					color: $color-text-muted;
					font-size: 1.1rem;
					transition: border-color $duration-hover $ease-out-quick;

					&:hover,
					&:focus-visible {
						border-color: rgba($color-accent, 0.6);
					}

					// Name tooltip: CSS-only, driven by `data-label` so unfamiliar
					// visitors can identify a logo without JS. `role="img"` +
					// `aria-label` (set alongside `data-label` in the markup)
					// covers screen readers independently of this hover state.
					&::after {
						content: attr(data-label);
						position: absolute;
						bottom: calc(100% + $space-1);
						left: 50%;
						transform: translate(-50%, $space-1);
						padding: $space-1 $space-2;
						border-radius: $radius-sm;
						background: $color-surface;
						border: 1px solid $glass-border;
						color: $color-text;
						font-family: $font-sans;
						font-size: $font-size-caption;
						white-space: nowrap;
						opacity: 0;
						pointer-events: none;
						transition:
							opacity $duration-hover $ease-out-quick,
							transform $duration-hover $ease-out-quick;
						z-index: 2;
					}

					&:hover::after,
					&:focus-visible::after {
						opacity: 1;
						transform: translate(-50%, 0);
					}
				}
			}

			.work-links {
				position: relative;
				z-index: 1;
				display: flex;
				flex-wrap: wrap;
				gap: $space-2;
				margin-top: auto;
				padding-top: $space-2;

				a {
					display: flex;
					align-items: center;
					gap: $space-1;
					padding: $space-1 $space-3;
					border: 1px solid rgba($color-accent, 0.25);
					border-radius: $radius-sm;
					background: rgba($color-accent, 0.08);
					color: $color-text;
					font-family: $font-sans;
					font-size: $font-size-caption;
					text-decoration: none;
					transition: border-color $duration-hover $ease-out-quick;

					&:hover,
					&:focus-visible {
						border-color: rgba($color-accent, 0.6);
					}
				}
			}
		}
	}
</style>
